# ==============================================================================
# PropManage (Digital Rental Collection) - Environment Variables Configuration
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Core Authentication & Database
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. Supabase Service Role Key (CRITICAL: NEVER EXPOSE TO CLIENT)
# Required by server actions, payment webhooks, cron routes, and admin operations.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. Mobile Money Payment Webhook Security
# Shared secret for verifying Telesom (ZAAD) / Somtel (eDahab) webhook signatures.
# Passed in the 'x-telecom-signature' request header to /api/webhooks/payments.
# ------------------------------------------------------------------------------
TELECOM_WEBHOOK_SECRET=your-telecom-webhook-secret-key

# ------------------------------------------------------------------------------
# 4. Automated Cron Job Secret Key
# Secret query key used to authenticate automated invocations of /api/cron?key=...
# ------------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-key

# ------------------------------------------------------------------------------
# 5. Playwright E2E Test Suite Credentials (Optional for local test runs)
# Test account used for verifying authentication and landlord workflows.
# ------------------------------------------------------------------------------
TEST_USER_EMAIL=test.landlord@example.com
TEST_USER_PASSWORD=YourSecureTestPassword123!
